# Optional build-time settings, read by scripts/prerender.mjs during `npm run build`.
# Set them in Vercel → Project → Settings → Environment Variables (Production), or copy this file
# to `.env` for local builds. Leave a value empty to turn that feature off. These values end up in
# public HTML (they are not secrets), but keep real values out of git anyway.

# Google Analytics 4 measurement ID (GA → Admin → Data streams → Web). Format: G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" method: only the value of content="…"
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools "Meta tag" method: only the value of content="…" (msvalidate.01)
BING_SITE_VERIFICATION=
